{
  "name": "wyrm-it",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@wyrm/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "harness:check": "node scripts/check-harness.mjs",
    "verify": "node scripts/check-harness.mjs && biome check . && turbo run typecheck test build e2e",
    "verify:fast": "node scripts/check-harness.mjs && biome check . && turbo run typecheck test",
    "e2e": "turbo run e2e",
    "eval": "pnpm --filter @wyrm/ai eval",
    "dev:portal": "turbo run dev --filter=@wyrm/portal"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
