{
  "name": "wyrm-it",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@wyrm/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "harness:check": "node scripts/check-harness.mjs",
    "verify": "pnpm harness:check && pnpm lint && turbo run typecheck test build",
    "verify:fast": "pnpm harness:check && pnpm lint && turbo run typecheck test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
