# Copy to apps/web/.env.local and fill in. Never commit real values.

# AI provider for the website demos (Phase 2+)
ANTHROPIC_API_KEY=

# Hard daily spend cap for all public demos combined, in US cents
DEMO_DAILY_BUDGET_CENTS=500

# Public site URL (metadata, sitemap). Optional on Vercel: its production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Booking calendar link (Cal.com or Calendly). Empty = "booking opens soon".
NEXT_PUBLIC_BOOKING_URL=

# Public business email shown on the site. Empty = no email shown.
NEXT_PUBLIC_CONTACT_EMAIL=
