# Copy to .env.local (git-ignored) and fill in from Supabase: Project Settings -> API keys.
# Never commit real values or paste them into chat.

# Project URL, e.g. https://abcd1234.supabase.co (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_ (older name: anon key; safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, starts with sb_secret_ (older name: service_role). SERVER ONLY, full access.
SUPABASE_SECRET_KEY=
