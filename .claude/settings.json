{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm verify:fast)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm harness:check)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": ["Read(./**/.env)", "Read(./**/.env.local)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-stop-check.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
